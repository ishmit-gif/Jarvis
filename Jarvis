name: Build APK
on:
  workflow_dispatch:
    inputs:
      backend_url:
        description: Server address
        default: "http://10.0.2.2:8000"
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: unzip -q jarvis.zip
      - run: sed -i "s|http://10.0.2.2:8000|$URL|" jarvis/app/build.gradle.kts
        env:
          URL: ${{ inputs.backend_url }}
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.9
      - run: gradle :app:assembleDebug
        working-directory: jarvis
      - uses: actions/upload-artifact@v4
        with:
          name: jarvis-debug-apk
          path: jarvis/app/build/outputs/apk/debug/app-debug.apk
